NODE_ENV=production
PORT=4173
PARSEN_DOMAIN=your-domain.example
PARSEN_PUBLIC_URL=https://your-domain.example
PARSEN_TRUST_PROXY=1
PARSEN_ADMIN_NAME=Nimble owner
PARSEN_ADMIN_EMAIL=owner@your-domain.example
PARSEN_ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
PARSEN_SESSION_DAYS=7
PARSEN_MAX_BODY_BYTES=22000000
PARSEN_MAX_DOCUMENT_BYTES=2000000
PARSEN_MEDIA_QUOTA_BYTES=1073741824
PARSEN_STORAGE_DIR=/var/lib/parsen
PARSEN_BACKUP_DIR=/backups

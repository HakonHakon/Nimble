NODE_ENV=production
PORT=4173
NIMBLE_DOMAIN=your-domain.example
NIMBLE_PUBLIC_URL=https://your-domain.example
NIMBLE_TRUST_PROXY=1
NIMBLE_ADMIN_NAME=Nimble owner
NIMBLE_ADMIN_EMAIL=owner@your-domain.example
NIMBLE_ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
NIMBLE_SESSION_DAYS=7
NIMBLE_MAX_BODY_BYTES=22000000
NIMBLE_MAX_DOCUMENT_BYTES=2000000
NIMBLE_MEDIA_QUOTA_BYTES=1073741824
NIMBLE_STORAGE_DIR=/var/lib/nimble
NIMBLE_BACKUP_DIR=/backups

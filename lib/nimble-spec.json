{
  "version": 2,
  "limits": {
    "pages": 100,
    "nodes": 5000,
    "depth": 12,
    "children": 500,
    "breakpoints": 5,
    "assets": 500,
    "colors": 40,
    "fonts": 20,
    "textChars": 20000,
    "richBlocks": 200,
    "richRuns": 2000,
    "listItems": 200,
    "galleryImages": 60,
    "shadows": 4,
    "gradientStops": 8,
    "tracks": 24,
    "gridLines": 48,
    "presets": 50,
    "fontFiles": 12
  },
  "patterns": {
    "id": "^[a-z][a-z0-9_-]{0,79}$",
    "key": "^[a-z][a-z0-9-]{0,31}$",
    "pageId": "^[a-z][a-z0-9-]{0,63}$",
    "pagePath": "^/(?:[a-z0-9-]+(?:/[a-z0-9-]+)*)?$",
    "reservedPath": "^/(?:api|assets|uploads|published|builder|control-panel|login)(?:/|$)",
    "hex": "^#(?:[0-9a-f]{6}|[0-9a-f]{8})$",
    "shortHex": "^#[0-9a-f]{3,4}$",
    "length": "^(-?)([0-9]{1,5}(?:\\.[0-9]{1,3})?)(px|%|vw|vh|rem|em)$",
    "fr": "^[0-9]{1,3}(?:\\.[0-9]{1,3})?fr$",
    "minmax": "^minmax\\(([^,()]+),([^,()]+)\\)$",
    "repeat": "^repeat\\((auto-fit|auto-fill),minmax\\(([^,()]+),([0-9]{1,3}(?:\\.[0-9]{1,3})?fr)\\)\\)$",
    "fontFamily": "^[A-Za-z0-9 ]{1,60}$",
    "fontFile": "^/uploads/[a-z0-9_-]+\\.(?:woff2|woff|ttf|otf)$",
    "email": "^[^\\s@<>\"']{1,64}@[^\\s@<>\"']{1,190}$",
    "phone": "^\\+?[0-9() -]{3,30}$",
    "lang": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$",
    "url": "^[hH][tT][tT][pP][sS]?://[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$",
    "domain": "^(localhost|[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?::[0-9]{1,5})?$"
  },
  "defaultBreakpoints": [
    { "id": "tablet", "name": "Tablet", "max": 1000 },
    { "id": "mobile", "name": "Mobile", "max": 750 }
  ],
  "breakpointRange": [320, 1920],
  "systemFonts": {
    "sans": "Inter, system-ui, sans-serif",
    "serif": "Georgia, serif",
    "mono": "ui-monospace, monospace"
  },
  "defaultColors": {
    "bg": "#ffffff",
    "ink": "#19192c",
    "muted": "#5f5e71",
    "line": "#e9e8ef",
    "accent": "#6957ff",
    "soft": "#f8f5ff"
  },
  "defaultFonts": [
    { "id": "heading", "source": "system", "family": "sans" },
    { "id": "body", "source": "system", "family": "sans" }
  ],
  "textStyleKeys": ["h1", "h2", "h3", "h4", "h5", "h6", "p1", "p2", "p3"],
  "defaultTextStyles": {
    "h1": { "desktop": { "font": "heading", "fontSize": "76px", "fontWeight": 700, "lineHeight": 1.05, "letterSpacing": "-0.06em", "color": "@ink" }, "tablet": { "fontSize": "56px" }, "mobile": { "fontSize": "40px" } },
    "h2": { "desktop": { "font": "heading", "fontSize": "38px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.05em", "color": "@ink" }, "tablet": { "fontSize": "32px" }, "mobile": { "fontSize": "28px" } },
    "h3": { "desktop": { "font": "heading", "fontSize": "19px", "fontWeight": 700, "lineHeight": 1.3, "color": "@ink" } },
    "h4": { "desktop": { "font": "heading", "fontSize": "17px", "fontWeight": 700, "lineHeight": 1.3, "color": "@ink" } },
    "h5": { "desktop": { "font": "heading", "fontSize": "15px", "fontWeight": 700, "lineHeight": 1.3, "color": "@ink" } },
    "h6": { "desktop": { "font": "heading", "fontSize": "13px", "fontWeight": 700, "lineHeight": 1.3, "color": "@ink" } },
    "p1": { "desktop": { "font": "body", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.6, "color": "@muted" } },
    "p2": { "desktop": { "font": "body", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.6, "color": "@muted" } },
    "p3": { "desktop": { "font": "body", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5, "color": "@muted" } }
  },
  "richBlockTags": ["p", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol"],
  "richRun": { "font": "font", "size": "length", "weight": "int:100:900", "highlight": "color" },
  "richBlock": { "lineHeight": "num:0.5:4", "letterSpacing": "slength" },
  "richDefaultStyle": { "p": "p1", "h1": "h1", "h2": "h2", "h3": "h3", "h4": "h4", "h5": "h5", "h6": "h6", "ul": "p1", "ol": "p1" },
  "nodeTypes": {
    "section": { "container": true, "root": true, "tags": ["section", "header", "footer", "div", "article", "aside", "nav"], "display": "grid" },
    "container": { "container": true, "tags": ["div", "article", "aside", "nav", "figure"], "display": "grid" },
    "text": { "display": "block", "props": { "doc": "richtext" } },
    "image": { "display": "block", "props": { "src": "media", "alt": "text:1000", "fit": "enum:cover,contain,fill,none", "link": "link" } },
    "button": { "display": "inline-flex", "props": { "label": "text:200", "link": "link" } },
    "video": { "display": "block", "props": { "src": "video", "poster": "media", "title": "text:200", "controls": "bool", "autoplay": "bool", "loop": "bool", "muted": "bool" } },
    "gallery": { "display": "grid", "props": { "images": "mediaList", "alt": "text:1000", "minItemWidth": "length", "itemHeight": "length", "gap": "length" } },
    "form": { "display": "block", "props": { "submitLabel": "text:120", "note": "text:500" } },
    "shape": { "display": "block", "props": { "shape": "enum:rect,ellipse,blob" } },
    "spacer": { "display": "block" },
    "divider": { "display": "block" },
    "menu": { "display": "flex", "props": { "orientation": "enum:horizontal,vertical", "activeColor": "color" } }
  },
  "layout": {
    "mode": "enum:grid,stack",
    "columns": "tracks",
    "rows": "tracks",
    "rowGap": "length",
    "columnGap": "length",
    "direction": "enum:row,column",
    "wrap": "bool",
    "justify": "enum:start,center,end,space-between,space-around,space-evenly,stretch",
    "align": "enum:start,center,end,stretch,baseline",
    "padding": "box",
    "minHeight": "size",
    "contentWidth": "size"
  },
  "place": {
    "cell": "cell",
    "justifySelf": "enum:start,center,end,stretch",
    "alignSelf": "enum:start,center,end,stretch",
    "margin": "margin",
    "width": "size",
    "height": "size",
    "minWidth": "size",
    "maxWidth": "size",
    "minHeight": "size",
    "maxHeight": "size",
    "rotate": "num:-360:360",
    "z": "int:0:9999",
    "order": "int:-999:999"
  },
  "style": {
    "color": "color",
    "background": "background",
    "opacity": "num:0:1",
    "border": "border",
    "radius": "box",
    "shadow": "shadows",
    "font": "font",
    "fontSize": "length",
    "fontWeight": "int:100:900",
    "lineHeight": "num:0.5:4",
    "letterSpacing": "slength",
    "textAlign": "enum:left,center,right,justify",
    "textTransform": "enum:none,uppercase,lowercase,capitalize",
    "padding": "box",
    "linkUnderline": "bool",
    "blendMode": "enum:normal,multiply,screen,overlay,darken,lighten,color-dodge,color-burn,difference,exclusion,luminosity",
    "scrollEffect": "enum:none,parallax,reveal"
  },
  "textStyle": {
    "font": "font",
    "fontSize": "length",
    "fontWeight": "int:100:900",
    "lineHeight": "num:0.5:4",
    "letterSpacing": "slength",
    "color": "color",
    "textTransform": "enum:none,uppercase,lowercase,capitalize"
  },
  "hover": {
    "color": "color",
    "background": "background",
    "borderColor": "color",
    "shadow": "shadows",
    "opacity": "num:0:1",
    "scale": "num:0.5:2",
    "translateY": "slength",
    "duration": "int:0:3000"
  },
  "typographyProps": ["color", "font", "fontSize", "fontWeight", "lineHeight", "letterSpacing", "textAlign", "textTransform"]
}

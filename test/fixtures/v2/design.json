{
  "version": 2,
  "site": { "name": "Design features" },
  "design": {
    "colors": { "brand": "#2255ff" },
    "fonts": [
      { "id": "display", "source": "custom", "family": "Brand Display", "files": [ { "src": "/uploads/brand-regular.woff2" }, { "src": "/uploads/brand-bold.woff2", "weight": 700 }, { "src": "/uploads/brand-italic.woff2", "weight": 400, "style": "italic" } ] },
      { "id": "legacy", "source": "custom", "family": "Legacy", "src": "/uploads/legacy.woff" },
      { "id": "heading", "source": "custom", "family": "Brand Display", "files": [ { "src": "/uploads/brand-regular.woff2" }, { "src": "/uploads/brand-bold.woff2", "weight": 700 } ] }
    ],
    "textStyles": { "h1": { "desktop": { "font": "display", "fontSize": "60px", "fontWeight": 700 } } },
    "presets": [
      { "id": "primary-button", "name": "Primary button", "type": "button", "style": { "desktop": { "background": { "kind": "color", "color": "@brand" }, "color": "#fff", "radius": ["999px", "999px", "999px", "999px"] }, "mobile": { "padding": ["10px", "16px", "10px", "16px"] } } },
      { "id": "empty", "name": "  Card  ", "type": "container" }
    ]
  },
  "header": "top",
  "menu": [
    { "id": "m-home", "label": "", "link": { "to": "page", "page": "home" } },
    { "id": "m-more", "label": "More & more", "children": [ { "id": "m-ext", "label": "Docs", "link": { "to": "url", "href": "https://example.com/docs", "newTab": true } }, { "id": "m-gone", "label": "Gone", "link": { "to": "page", "page": "missing" } } ] },
    { "id": "m-dead", "label": "Dead", "link": { "to": "page", "page": "missing" } },
    { "id": "m-about", "label": "About", "link": { "to": "page", "page": "about" }, "children": [ { "id": "m-promo", "label": "Offer", "link": { "to": "anchor", "node": "promo" } } ] }
  ],
  "pages": [ { "id": "home", "name": "Home", "children": ["hero", "plain", "promo"] }, { "id": "about", "name": "About", "children": [] } ],
  "nodes": {
    "top": { "type": "section", "tag": "header", "props": { "headerMode": "overlay-sticky", "scrollStyle": "solid" }, "children": ["nav", "anchors", "follow", "page-embed"] },
    "nav": { "type": "menu", "style": { "mobile": { "menuMode": "hamburger" }, "tablet": { "menuMode": "inline" } } },
    "anchors": { "type": "menu", "props": { "source": "sections", "orientation": "vertical" } },
    "follow": { "type": "social", "props": { "size": "28px", "items": [ { "label": "Email", "url": "mailto:hi@example.com", "icon": "mail" }, { "url": "https://example.com/u/nimble", "icon": "globe" }, { "label": "Call", "url": "tel:+47 123 45 678" } ] } },
    "page-embed": { "type": "embed", "props": { "kind": "html", "html": "<script>alert(1)</script><b>Widget</b>", "title": "Widget" } },
    "map-embed": { "type": "embed", "props": { "kind": "map", "address": "Storgata 1, Oslo (it's here!)", "zoom": 15 } },
    "site-embed": { "type": "embed", "props": { "kind": "website", "url": "https://example.com/calendar?a=1&b=2" } },
    "bad-embed": { "type": "embed", "props": { "kind": "website", "url": "http://insecure.example" } },
    "hero": { "type": "section", "name": "Welcome", "children": ["title", "cta"],
      "style": {
        "desktop": { "background": { "kind": "video", "src": "/uploads/loop.mp4", "poster": "/uploads/poster.jpg", "overlay": "#00000066", "color": "#101020" }, "scrollEffect": "parallax" },
        "tablet": { "background": { "kind": "image", "src": "/uploads/still.jpg", "focal": [30, 75.5], "overlay": "#00000040" }, "scrollEffect": "reveal" },
        "mobile": { "background": { "kind": "video", "src": "/uploads/small.webm" }, "scrollEffect": "none" }
      } },
    "title": { "type": "text", "props": { "doc": [
      { "t": "h1", "c": [ { "text": "Hover me" } ] },
      { "t": "p", "style": "p2", "align": "center", "lineHeight": 1.75, "letterSpacing": "0.02em", "c": [ { "text": "Big ", "size": "28px", "weight": 300 }, { "text": "brand", "font": "display", "color": "@brand", "highlight": "#ffee0080", "b": true }, { "text": " text" } ] },
      { "t": "ul", "lineHeight": 2, "items": [ [ { "text": "One", "highlight": "@brand" } ], [ { "text": "Two", "size": "1.2em" } ] ] }
    ] }, "hover": { "color": "@brand", "duration": 400 }, "style": { "desktop": { "blendMode": "difference" } } },
    "cta": { "type": "button", "props": { "label": "Go" }, "hover": { "background": { "kind": "gradient", "angle": 90, "stops": [ { "color": "@brand", "at": 0 }, { "color": "#ff00aa", "at": 100 } ] }, "borderColor": "#000", "shadow": [ { "y": "8px", "blur": "24px", "color": "#00000040" } ], "opacity": 0.9, "scale": 1.05, "translateY": "-2px" }, "place": { "desktop": { "rotate": 3 } } },
    "plain": { "type": "section", "hover": { "duration": 0 }, "children": ["star", "linked-icon", "icon-button", "icon-only", "vline", "hline", "g-captions", "g-masonry", "g-slider", "song", "photo", "faq", "info-tabs", "map-embed", "site-embed", "bad-embed"] },
    "faq": { "type": "accordion", "props": { "firstOpen": true, "activeColor": "@brand" }, "children": ["faq-1", "faq-2"] },
    "faq-1": { "type": "container", "name": "What is it?", "children": ["faq-1-text"] },
    "faq-1-text": { "type": "text", "props": { "doc": [ { "t": "p", "c": [ { "text": "A website builder." } ] } ] } },
    "faq-2": { "type": "container", "children": [] },
    "info-tabs": { "type": "tabs", "props": { "tabAlign": "stretch", "tabStyle": "pills", "activeColor": "#ff0066" }, "children": ["tab-a", "tab-b"], "layout": { "desktop": { "padding": ["8px", "8px", "8px", "8px"], "mode": "stack" } } },
    "tab-a": { "type": "container", "name": "Overview <1>", "children": [] },
    "tab-b": { "type": "text", "props": { "doc": [ { "t": "p", "c": [ { "text": "Details" } ] } ] } },
    "promo": { "type": "section", "name": "Newsletter", "props": { "popup": true, "popupOpen": "load", "popupDelay": 3, "popupWidth": "480px" }, "children": [] },
    "g-captions": { "type": "gallery", "props": { "images": ["/uploads/a.jpg", "/uploads/b.jpg", "/uploads/c.jpg"], "captions": ["First <b>", "", "Third", "", ""], "alt": "Work" } },
    "g-masonry": { "type": "gallery", "props": { "images": ["/uploads/a.jpg", "/uploads/b.jpg"], "layout": "masonry", "minItemWidth": "240px", "gap": "12px", "lightbox": true } },
    "g-slider": { "type": "gallery", "props": { "images": ["/uploads/a.jpg", "/uploads/b.jpg"], "captions": ["One", "Two"], "layout": "slider", "itemHeight": "60vh", "autoplay": true, "interval": 7, "lightbox": true } },
    "song": { "type": "audio", "props": { "src": "/uploads/song.mp3", "title": "Our jingle", "loop": true } },
    "photo": { "type": "image", "props": { "src": "/uploads/a.jpg", "alt": "A photo", "focal": [20, 80.5] }, "style": { "desktop": { "filter": "vintage" }, "mobile": { "filter": "none" } } },
    "star": { "type": "icon", "props": { "icon": "star", "weight": 1.5 }, "style": { "desktop": { "color": "@brand" } }, "place": { "desktop": { "width": "48px", "height": "48px", "pin": "top", "pinOffset": "10px" }, "mobile": { "pin": "none" } } },
    "linked-icon": { "type": "icon", "props": { "icon": "mail", "label": "Email us", "link": { "to": "email", "address": "hi@example.com" } } },
    "icon-button": { "type": "button", "props": { "label": "Next", "icon": "arrow-right", "iconPosition": "end", "link": { "to": "url", "href": "https://example.com" } } },
    "icon-only": { "type": "button", "props": { "label": "Search", "icon": "search", "hideLabel": true } },
    "vline": { "type": "divider", "props": { "orientation": "vertical", "thickness": "3px", "lineStyle": "dashed" }, "place": { "desktop": { "height": "80px" } } },
    "hline": { "type": "divider", "props": { "lineStyle": "dotted" } }
  }
}
